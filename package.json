{
    "name": "clamsentinel",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently -k \"npm --prefix frontend run dev\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs\"",
        "build": "npm --prefix frontend run build",
        "start": "electron electron/main.cjs",
        "typecheck": "npm --prefix frontend run typecheck"
    },
    "devDependencies": {
        "concurrently": "^9.1.2",
        "electron": "^37.0.0",
        "wait-on": "^8.0.3"
    },
    "allowScripts": {
        "electron@37.10.3": true
    }
}